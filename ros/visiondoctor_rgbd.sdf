<?xml version="1.0"?>
<sdf version="1.10">
  <world name="visiondoctor_rgbd">
    <physics name="deterministic" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.35 0.35 0.35 1</ambient>
      <background>0.025 0.031 0.042 1</background>
      <shadows>false</shadows>
    </scene>

    <light name="key_light" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 2 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-1 0 -0.2</direction>
    </light>

    <!-- Gazebo camera body: +X forward, +Y left, +Z up. -->
    <model name="vision_camera">
      <static>true</static>
      <pose>0.14227413 0.56399989 0.63231015 -2.03444393 -0.72972766 -2.03444394</pose>
      <link name="camera_link">
        <sensor name="rgbd" type="rgbd_camera">
          <always_on>true</always_on>
          <update_rate>15</update_rate>
          <topic>/visiondoctor/rgbd</topic>
          <camera>
            <horizontal_fov>1.0471975512</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>3.0</far>
            </clip>
          </camera>
        </sensor>
      </link>
    </model>

    <!-- A far surface keeps the complete depth image finite and measurable. -->
    <model name="backdrop">
      <static>true</static>
      <pose>0.35017254 -0.69092624 0.96731374 0.09176023 0.00167026 1.97078945</pose>
      <link name="backdrop_link">
        <visual name="backdrop_visual">
          <geometry>
            <box><size>0.02 20.0 20.0</size></box>
          </geometry>
          <material>
            <ambient>0.06 0.08 0.12 1</ambient>
            <diffuse>0.06 0.08 0.12 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!--
      Model origin is the green marker center at world [-0.0244, 0.2307, 0.9656].
      In the ROS optical frame the three centers are:
        origin [0.00, 0.00, 0.50]
        red X  [0.08, 0.00, 0.50]
        blue Y [0.00, 0.08, 0.50]
    -->
    <model name="vision_target">
      <static>true</static>
      <pose>-0.02439253 0.23066656 0.96564348 0.09176023 0.00167026 1.97078945</pose>
      <link name="target_link">
        <visual name="board">
          <pose>-0.00970703 0.01250518 0.01222269 -0.79682148 -0.50676490 0.21713622</pose>
          <geometry>
            <box><size>0.20 0.20 0.02</size></box>
          </geometry>
          <material>
            <ambient>0.12 0.14 0.18 1</ambient>
            <diffuse>0.12 0.14 0.18 1</diffuse>
          </material>
        </visual>

        <visual name="origin_marker">
          <pose>0 0 0 -0.79682148 -0.50676490 0.21713622</pose>
          <geometry>
            <cylinder><radius>0.014</radius><length>0.002</length></cylinder>
          </geometry>
          <material>
            <ambient>0.05 1.0 0.10 1</ambient>
            <diffuse>0.05 1.0 0.10 1</diffuse>
            <emissive>0.03 0.7 0.06 1</emissive>
          </material>
        </visual>

        <visual name="x_marker">
          <pose>0 -0.08 0 -0.79682148 -0.50676490 0.21713622</pose>
          <geometry>
            <cylinder><radius>0.014</radius><length>0.002</length></cylinder>
          </geometry>
          <material>
            <ambient>1.0 0.05 0.05 1</ambient>
            <diffuse>1.0 0.05 0.05 1</diffuse>
            <emissive>0.7 0.03 0.03 1</emissive>
          </material>
        </visual>

        <visual name="y_marker">
          <pose>0 0 -0.08 -0.79682148 -0.50676490 0.21713622</pose>
          <geometry>
            <cylinder><radius>0.014</radius><length>0.002</length></cylinder>
          </geometry>
          <material>
            <ambient>0.05 0.10 1.0 1</ambient>
            <diffuse>0.05 0.10 1.0 1</diffuse>
            <emissive>0.03 0.06 0.7 1</emissive>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
