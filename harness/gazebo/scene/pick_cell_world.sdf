<?xml version="1.0"?>
<sdf version="1.10">
  <!-- The UR5e itself is spawned by ur_simulation_gz.  This world owns the
       workcell, cameras and workpieces; the two-finger tool is mounted on the
       robot itself through scene/ur5e_pick_tool.urdf.xacro. -->
  <world name="pick_a17">
    <!-- Motion is assessed at the TCP; this cell intentionally has no
         payload dynamics or gravity-induced controller limit. -->
    <gravity>0 0 0</gravity>
    <physics name="fixed_step" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.32 0.35 0.40 1</ambient>
      <background>0.025 0.033 0.050 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="key" type="directional">
      <pose>0 0 3 0 0 0</pose>
      <diffuse>0.92 0.95 1.0 1</diffuse>
      <specular>0.20 0.20 0.20 1</specular>
      <direction>-0.4 0.3 -1</direction>
    </light>
    <light name="fill" type="point">
      <pose>0.9 -1.0 1.8 0 0 0</pose>
      <diffuse>0.40 0.48 0.65 1</diffuse>
      <attenuation><range>5</range><linear>0.25</linear><quadratic>0.05</quadratic></attenuation>
    </light>

    <model name="floor">
      <static>true</static>
      <pose>0 0 -0.84 0 0 0</pose>
      <link name="floor_link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry></collision>
        <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <material><ambient>0.08 0.10 0.13 1</ambient><diffuse>0.08 0.10 0.13 1</diffuse></material></visual>
      </link>
    </model>

    <model name="worktable">
      <static>true</static>
      <!-- World z=0 is the top surface.  The UR5e is fixed directly on this
           table; objects therefore stay low rather than being elevated just
           to make an otherwise side-on grasp reachable. -->
      <pose>0 0 0 0 0 0</pose>
      <link name="table_link">
        <visual name="top_visual"><pose>0.75 0 -0.04 0 0 0</pose><geometry><box><size>2.20 2.00 0.08</size></box></geometry>
          <material><ambient>0.20 0.24 0.29 1</ambient><diffuse>0.20 0.24 0.29 1</diffuse></material></visual>
        <visual name="leg_front_left"><pose>-0.20 -0.90 -0.44 0 0 0</pose><geometry><box><size>0.10 0.10 0.80</size></box></geometry><material><ambient>0.13 0.16 0.20 1</ambient></material></visual>
        <visual name="leg_front_right"><pose>1.70 -0.90 -0.44 0 0 0</pose><geometry><box><size>0.10 0.10 0.80</size></box></geometry><material><ambient>0.13 0.16 0.20 1</ambient></material></visual>
        <visual name="leg_back_left"><pose>-0.20 0.90 -0.44 0 0 0</pose><geometry><box><size>0.10 0.10 0.80</size></box></geometry><material><ambient>0.13 0.16 0.20 1</ambient></material></visual>
        <visual name="leg_back_right"><pose>1.70 0.90 -0.44 0 0 0</pose><geometry><box><size>0.10 0.10 0.80</size></box></geometry><material><ambient>0.13 0.16 0.20 1</ambient></material></visual>
      </link>
    </model>

    <model name="robot_mount">
      <static>true</static>
      <link name="mount_link">
        <!-- This visible mounting plate makes it clear that the robot base is
             on the tabletop, not on the floor beneath it. -->
        <visual name="base_plate"><pose>0 0 -0.018 0 0 0</pose><geometry><cylinder><radius>0.185</radius><length>0.036</length></cylinder></geometry>
          <material><ambient>0.10 0.13 0.18 1</ambient><diffuse>0.10 0.13 0.18 1</diffuse></material></visual>
      </link>
    </model>

    <model name="part_fixture">
      <static>true</static>
      <!-- The plate begins well in front of the base-mount exclusion zone.
           Its two low nests support a genuine top-down A/B demonstration. -->
      <pose>0.620 0 0 0 0 0</pose>
      <link name="fixture_link">
        <visual name="base_plate"><pose>0 0 0.025 0 0 0</pose><geometry><box><size>0.70 1.00 0.05</size></box></geometry>
          <material><ambient>0.28 0.31 0.36 1</ambient><diffuse>0.28 0.31 0.36 1</diffuse></material></visual>
        <visual name="nest_A"><pose>-0.120 -0.100 0.060 0 0 0</pose><geometry><box><size>0.16 0.14 0.02</size></box></geometry>
          <material><ambient>0.22 0.25 0.30 1</ambient><diffuse>0.22 0.25 0.30 1</diffuse></material></visual>
        <visual name="nest_B"><pose>-0.120 -0.300 0.060 0 0 0</pose><geometry><cylinder><radius>0.080</radius><length>0.02</length></cylinder></geometry>
          <material><ambient>0.22 0.25 0.30 1</ambient><diffuse>0.22 0.25 0.30 1</diffuse></material></visual>
      </link>
    </model>

    <model name="part_A_flat">
      <static>true</static>
      <pose>0.500000 -0.100000 0.100000 0 0 0</pose>
      <link name="part_link">
        <!-- Arrival at the configured TCP is the grasp predicate.  Keep the
             part visual-only so contact does not turn a software offset into
             a Gazebo contact failure. -->
        <visual name="body"><geometry><box><size>0.10 0.04 0.06</size></box></geometry>
          <material><ambient>0.10 0.55 0.94 1</ambient><diffuse>0.10 0.55 0.94 1</diffuse></material></visual>
        <visual name="fiducial"><pose>0 0 0.028 0 0 0</pose><geometry><box><size>0.045 0.025 0.003</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient></material></visual>
      </link>
    </model>

    <model name="part_B_tilted">
      <static>true</static>
      <pose>0.500000 -0.300000 0.100000 0 0 0</pose>
      <link name="part_link">
        <visual name="body"><geometry><cylinder><radius>0.020</radius><length>0.06</length></cylinder></geometry>
          <material><ambient>1.0 0.48 0.10 1</ambient><diffuse>1.0 0.48 0.10 1</diffuse></material></visual>
        <visual name="cap"><pose>0 0 0.028 0 0 0</pose><geometry><cylinder><radius>0.014</radius><length>0.004</length></cylinder></geometry><material><ambient>0.96 0.96 0.96 1</ambient></material></visual>
      </link>
    </model>

    <model name="rgbd_camera">
      <static>true</static>
      <pose>1.15 -1.10 1.45 0 0.77 2.20</pose>
      <link name="camera_link">
        <sensor name="rgbd" type="rgbd_camera">
          <always_on>true</always_on><update_rate>12</update_rate><topic>/pick_cell/rgbd</topic>
          <camera><horizontal_fov>1.0471975512</horizontal_fov><image><width>640</width><height>480</height><format>R8G8B8</format></image><clip><near>0.1</near><far>4.0</far></clip></camera>
        </sensor>
      </link>
    </model>

    <model name="observer_camera">
      <static>true</static>
      <pose>1.65 1.35 1.45 0 0.55 -2.34</pose>
      <link name="observer_link">
        <sensor name="observer" type="camera">
          <always_on>true</always_on><update_rate>8</update_rate><topic>/pick_cell/observer</topic>
          <camera><horizontal_fov>1.1344640138</horizontal_fov><image><width>640</width><height>480</height><format>R8G8B8</format></image><clip><near>0.1</near><far>5.0</far></clip></camera>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
