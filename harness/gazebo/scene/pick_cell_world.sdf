<?xml version="1.0"?>
<sdf version="1.10">
  <!-- The UR5e itself is spawned by ur_simulation_gz.  This world owns the
       workcell, cameras, workpieces, and a visible two-finger tool marker. -->
  <world name="pick_a17">
    <physics name="fixed_step" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.32 0.35 0.40 1</ambient>
      <background>0.025 0.033 0.050 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="key" type="directional">
      <pose>0 0 3 0 0 0</pose>
      <diffuse>0.92 0.95 1.0 1</diffuse>
      <specular>0.20 0.20 0.20 1</specular>
      <direction>-0.4 0.3 -1</direction>
    </light>
    <light name="fill" type="point">
      <pose>0.9 -1.0 1.8 0 0 0</pose>
      <diffuse>0.40 0.48 0.65 1</diffuse>
      <attenuation><range>5</range><linear>0.25</linear><quadratic>0.05</quadratic></attenuation>
    </light>

    <model name="floor">
      <static>true</static>
      <pose>0 0 -0.84 0 0 0</pose>
      <link name="floor_link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry></collision>
        <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <material><ambient>0.08 0.10 0.13 1</ambient><diffuse>0.08 0.10 0.13 1</diffuse></material></visual>
      </link>
    </model>

    <model name="worktable">
      <static>true</static>
      <!-- The UR5e's base is at world origin, directly on this large table.
           The pick area stays in front of the fixed base on the same surface. -->
      <pose>0 0 0 0 0 0</pose>
      <link name="table_link">
        <collision name="top_collision"><pose>0.45 0 -0.04 0 0 0</pose><geometry><box><size>1.60 1.20 0.08</size></box></geometry></collision>
        <visual name="top_visual"><pose>0.45 0 -0.04 0 0 0</pose><geometry><box><size>1.60 1.20 0.08</size></box></geometry>
          <material><ambient>0.20 0.24 0.29 1</ambient><diffuse>0.20 0.24 0.29 1</diffuse></material></visual>
        <visual name="leg_front_left"><pose>-0.20 -0.50 -0.44 0 0 0</pose><geometry><box><size>0.10 0.10 0.80</size></box></geometry><material><ambient>0.13 0.16 0.20 1</ambient></material></visual>
        <visual name="leg_front_right"><pose>1.10 -0.50 -0.44 0 0 0</pose><geometry><box><size>0.10 0.10 0.80</size></box></geometry><material><ambient>0.13 0.16 0.20 1</ambient></material></visual>
        <visual name="leg_back_left"><pose>-0.20 0.50 -0.44 0 0 0</pose><geometry><box><size>0.10 0.10 0.80</size></box></geometry><material><ambient>0.13 0.16 0.20 1</ambient></material></visual>
        <visual name="leg_back_right"><pose>1.10 0.50 -0.44 0 0 0</pose><geometry><box><size>0.10 0.10 0.80</size></box></geometry><material><ambient>0.13 0.16 0.20 1</ambient></material></visual>
      </link>
    </model>

    <model name="part_A_flat">
      <static>true</static>
      <pose>0.365 0.173 0.060 0 0 0.36</pose>
      <link name="part_link">
        <collision name="collision"><geometry><box><size>0.11 0.07 0.12</size></box></geometry></collision>
        <visual name="body"><geometry><box><size>0.11 0.07 0.12</size></box></geometry>
          <material><ambient>0.10 0.55 0.94 1</ambient><diffuse>0.10 0.55 0.94 1</diffuse></material></visual>
        <visual name="fiducial"><pose>0 0 0.061 0 0 0</pose><geometry><box><size>0.045 0.025 0.003</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient></material></visual>
      </link>
    </model>

    <model name="part_B_tilted">
      <static>true</static>
      <pose>0.349 -0.189 0.075 0.12 -0.08 -0.60</pose>
      <link name="part_link">
        <collision name="collision"><geometry><cylinder><radius>0.045</radius><length>0.13</length></cylinder></geometry></collision>
        <visual name="body"><geometry><cylinder><radius>0.045</radius><length>0.13</length></cylinder></geometry>
          <material><ambient>1.0 0.48 0.10 1</ambient><diffuse>1.0 0.48 0.10 1</diffuse></material></visual>
        <visual name="cap"><pose>0 0 0.066 0 0 0</pose><geometry><cylinder><radius>0.033</radius><length>0.004</length></cylinder></geometry><material><ambient>0.96 0.96 0.96 1</ambient></material></visual>
      </link>
    </model>

    <model name="rgbd_camera">
      <static>true</static>
      <pose>1.15 -1.10 1.45 0 0.77 2.20</pose>
      <link name="camera_link">
        <sensor name="rgbd" type="rgbd_camera">
          <always_on>true</always_on><update_rate>12</update_rate><topic>/pick_cell/rgbd</topic>
          <camera><horizontal_fov>1.0471975512</horizontal_fov><image><width>640</width><height>480</height><format>R8G8B8</format></image><clip><near>0.1</near><far>4.0</far></clip></camera>
        </sensor>
      </link>
    </model>

    <model name="observer_camera">
      <static>true</static>
      <pose>1.65 1.35 1.45 0 0.55 -2.34</pose>
      <link name="observer_link">
        <sensor name="observer" type="camera">
          <always_on>true</always_on><update_rate>8</update_rate><topic>/pick_cell/observer</topic>
          <camera><horizontal_fov>1.1344640138</horizontal_fov><image><width>640</width><height>480</height><format>R8G8B8</format></image><clip><near>0.1</near><far>5.0</far></clip></camera>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
