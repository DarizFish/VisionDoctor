# Required. Never commit the real value.
VISIONDOCTOR_LLM_API_KEY=

# OpenAI-compatible endpoint and exact provider model ID.
VISIONDOCTOR_LLM_BASE_URL=https://api.deepseek.com
VISIONDOCTOR_LLM_MODEL=deepseek-v4-flash

# Optional fail-closed limits.
VISIONDOCTOR_LLM_TIMEOUT_S=300
VISIONDOCTOR_LLM_MAX_TOKENS=32768
VISIONDOCTOR_LLM_MAX_TOOL_ITERATIONS=12

# Required for real image turns. An OpenAI-compatible endpoint serving a
# vision-language model; the key falls back to VISIONDOCTOR_LLM_API_KEY.
VISIONDOCTOR_VISION_API_KEY=
VISIONDOCTOR_VISION_BASE_URL=https://api.deepseek.com/v1
VISIONDOCTOR_VISION_MODEL=deepseek-vl
VISIONDOCTOR_VISION_TIMEOUT_S=300
